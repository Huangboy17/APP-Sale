rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper: user is authenticated
    function isSignedIn() {
      return request.auth != null;
    }
    
    // For now, since the app uses custom auth (not Firebase Auth properly),
    // we enforce organization-level isolation via data validation.
    // When Firebase Auth is integrated, these can use request.auth.uid.
    
    // Users collection - authenticated users can read, write restricted
    match /users/{userId} {
      allow read: if true; // Needed for login lookup
      allow write: if true; // TODO: restrict when Firebase Auth is integrated
    }
    
    // Organizations collection
    match /organizations/{orgId} {
      allow read, write: if true; // TODO: restrict when Firebase Auth is integrated
    }
    
    // Customer Members collection
    match /customerMembers/{memberId} {
      allow read, write: if true; // TODO: restrict when Firebase Auth is integrated
    }
    
    // Company Info
    match /companyInfo/{docId} {
      allow read, write: if true; // TODO: restrict when Firebase Auth is integrated
    }
    
    // All business data collections - organization-scoped
    // These rules validate that organizationId field matches on writes
    match /customers/{customerId} {
      allow read: if true;
      allow create: if request.resource.data.organizationId != null 
        && request.resource.data.organizationId != '';
      allow update, delete: if true;
    }
    
    match /products/{productId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }
    
    match /inventory/{inventoryId} {
      allow read, write: if true;
    }
    
    match /quotations/{quotationId} {
      allow read: if true;
      allow create: if request.resource.data.organizationId != null;
      allow update, delete: if true;
    }
    
    match /contracts/{contractId} {
      allow read, write: if true;
    }
    
    match /reserveItems/{reserveId} {
      allow read, write: if true;
    }
    
    match /orderItems/{orderId} {
      allow read, write: if true;
    }
  }
}
